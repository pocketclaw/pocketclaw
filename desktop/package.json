{
  "name": "pocketclaw-desktop",
  "version": "1.0.0",
  "description": "PocketClaw Desktop — Setup, monitor, and manage your PocketClaw AI device",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "prepare-payload": "bash scripts/prepare-payload.sh",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "com.pocketclaw.desktop",
    "productName": "PocketClaw Desktop",
    "directories": { "output": "build" },
    "files": ["electron/**/*", "src/**/*"],
    "extraResources": [{ "from": "payload", "to": "payload", "filter": ["**/*"] }],
    "win": { "target": "dir", "icon": "assets/icon.ico" },
    "mac": { "target": "dmg", "icon": "assets/icon.icns", "category": "public.app-category.utilities" },
    "linux": { "target": "AppImage", "icon": "assets/icon.png", "category": "Utility" },
    "nsis": { "oneClick": true, "allowToChangeInstallationDirectory": false }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  }
}

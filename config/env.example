KIMI_API_KEY=sk-kimi-YOUR_KEY_HERE
MOONSHOT_API_KEY=sk-kimi-YOUR_KEY_HERE
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# Dashboard API token (strongly recommended). Without it, anyone on the same
# network can use the dashboard API on port 9000. Send it as the
# X-PocketClaw-Token header or ?token= parameter.
# Generate one, for example: openssl rand -hex 24
POCKETCLAW_TOKEN=
